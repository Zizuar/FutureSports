{
  "name": "futuresports",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:wrangler": "wrangler dev",
    "build": "next build",
    "build:cf": "npx opennextjs-cloudflare build",
    "preview": "npm run build:cf && npx opennextjs-cloudflare preview",
    "deploy:staging": "npm run build:cf && wrangler deploy --env staging",
    "deploy:production": "npm run build:cf && wrangler deploy --env production",
    "start": "next start",
    "lint": "eslint .",
    "sync:assets": "node scripts/sync-image-assets.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "next": "^16.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "wrangler": "^4.97.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.7",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.15.0"
  }
}
